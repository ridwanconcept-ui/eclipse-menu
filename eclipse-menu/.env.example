# ---------- Server ----------
PORT=4000
NODE_ENV=development
DATA_DIR=./data
# SQLite file (defaults to ./data/eclipse.db)
# DATABASE_FILE=./data/eclipse.db

# Public HTTPS URL guests will reach the menu on. QR codes are built from this.
# Leave blank in local dev to auto-detect from the incoming request host.
PUBLIC_BASE_URL=

# First administrator created by `npm run seed`.
# If ADMIN_PASSWORD is omitted a strong random password is printed once.
ADMIN_EMAIL=admin@eclipse.local
ADMIN_PASSWORD=

# ---------- Web (Vite dev) ----------
WEB_PORT=5173
API_TARGET=http://127.0.0.1:4000
